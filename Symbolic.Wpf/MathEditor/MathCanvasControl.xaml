<UserControl x:Class="Calcpad.Wpf.MathEditor.MathCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Background="White"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="#F5F5DC" BorderBrush="#CCC" BorderThickness="1,1,1,0" Padding="5,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MathCanvas" FontSize="10" Foreground="#666" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="#E3F2FD" BorderBrush="#1976D2" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                    <TextBlock x:Name="StatusText" Text="Listo" FontSize="9" Foreground="#1976D2"/>
                </Border>
                <!-- Zoom controls -->
                <Button Content="−" Width="22" Height="22" FontSize="12" Click="ZoomOut_Click"
                        ToolTip="Zoom Out" Margin="0,0,2,0" Focusable="False"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="9" VerticalAlignment="Center"
                           Foreground="#666" Margin="2,0,2,0"/>
                <Button Content="+" Width="22" Height="22" FontSize="12" Click="ZoomIn_Click"
                        ToolTip="Zoom In" Focusable="False"/>
                <!-- ═══ Paleta de botones: inserta notación matemática ═══ -->
                <Border Width="1" Background="#CCC" Margin="8,2,8,2"/>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <WrapPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="MinWidth" Value="30"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="Margin" Value="1,0"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontFamily" Value="Cambria Math, Cambria"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="∫"  Click="PaletteButton_Click" Tag="$Integral{■ @ x = 0 : 1}" ToolTip="Integral simple"/>
                    <Button Content="∬"  Click="PaletteButton_Click" Tag="$Integral{$Integral{■ @ x = -1 : 1} @ y = -1 : 1}" ToolTip="Integral doble"/>
                    <Button Content="∭"  Click="PaletteButton_Click" Tag="$Integral{$Integral{$Integral{■ @ x = -1 : 1} @ y = -1 : 1} @ z = -1 : 1}" ToolTip="Integral triple"/>
                    <Button Content="∑"  Click="PaletteButton_Click" Tag="$Sum{■ @ k = 1 : n}" ToolTip="Sumatoria"/>
                    <Button Content="∏"  Click="PaletteButton_Click" Tag="$Product{■ @ k = 1 : n}" ToolTip="Productoria"/>
                    <Button Content="a/b" Click="PaletteButton_Click" FontSize="12" Tag="(■)/(b)" ToolTip="Fracción"/>
                    <Button Content="√"  Click="PaletteButton_Click" Tag="sqrt(■)" ToolTip="Raíz cuadrada"/>
                    <Button Content="xⁿ" Click="PaletteButton_Click" FontSize="12" Tag="■^n" ToolTip="Potencia"/>
                    <Button Content="d/dx" Click="PaletteButton_Click" FontSize="11" Tag="$Slope{■ @ x = 0}" ToolTip="Derivada"/>
                    <Button Content="[ ]" Click="PaletteButton_Click" FontSize="12" Tag="[■]" ToolTip="Vector / matriz"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Main canvas area with scroll -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False"
                      Background="White"
                      HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Top">
            <Canvas x:Name="EditorCanvas"
                    x:FieldModifier="public"
                    AutomationProperties.AutomationId="EditorCanvas"
                    Background="White"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    ClipToBounds="True"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#CCC" BorderThickness="1,1,1,0" Padding="5,2">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LineInfo" Text="Ln 1" FontSize="9" Foreground="#888"
                           VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock x:Name="ParseInfo" Text="" FontSize="9" Foreground="#888"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
