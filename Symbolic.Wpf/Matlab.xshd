    <!-- numeros: 25, 3.14, 1e-3, 25e6, .5 -->
    <Rule color="Number">
      \b\d+(\.\d*)?([eE][+-]?\d+)?
      |
      \.\d+([eE][+-]?\d+)?
    </Rule>

  </RuleSet>
</SyntaxDefinition>
