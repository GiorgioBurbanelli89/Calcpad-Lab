                </Grid>
            </GroupBox>
            <GroupBox x:Name="OutputFrame" Grid.Column="2"
                      FontFamily="Segoe UI Semibold" FontWeight="Bold"  FontSize="13"
                      VerticalContentAlignment="Stretch" Margin="4,1,6,1"
                      BorderBrush="{DynamicResource ThemeButtonBorder}" Background="{DynamicResource ThemePanelBg}"
                      Foreground="{DynamicResource ThemeAccentGold}"
                      Header="{x:Static wpf:MainWindowResources.Output}" >
                <Grid Background="{DynamicResource ThemePanelBg}">
                    <Wpf:WebView2 x:Name="WebViewer" Margin="5,5,5,5" KeyUp="WebViewer_KeyUp" PreviewKeyDown="WebViewer_PreviewKeyDown" NavigationCompleted="WebViewer_NavigationCompleted" WebMessageReceived="WebViewer_WebMessageReceived" />
                    <me:MathCanvasControl x:Name="MathCanvasView" Visibility="Collapsed" Margin="5,5,5,5"/>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Margin="1,5,1,0" Background="#32DDDDDD" />
