                                Style="{StaticResource RoundButton}" Margin="475,57,0,0" FontSize="10.5" Width="46"
                                ToolTip="integral(@(x) f, a, b) - integral definida" VerticalAlignment="Top"/>
                        <Button Click="Button_Click" Content="linsp" Tag="linspace(a, b, n)"
                                Style="{StaticResource RoundButton}" Margin="523,57,0,0" FontSize="10.5" Width="48"
