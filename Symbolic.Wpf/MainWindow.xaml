<Window xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:Calcpad.Wpf"
    xmlns:me="clr-namespace:Calcpad.Wpf.MathEditor"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Calcpad.Wpf.MainWindow"
    Title=" Hekatan Lab 1.0.0 — MATLAB-syntax scientific worksheets"
    Height="800"
    Width="1200"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ThemeWindowBg}"
    Icon="Resources/calcpad.ico"
    HorizontalContentAlignment="Center"
    WindowStyle="ThreeDBorderWindow" 
    Closing="Window_Closing"
    KeyUp="Window_KeyUp" 
    Unloaded="Window_Unloaded" 
    Loaded="Window_Loaded"
    Activated="Window_Activated" 
    ContentRendered="Window_ContentRendered">
    <Window.Resources>
        <!-- ============ TEMA (Dark por defecto; el toggle reasigna estos brushes) ============ -->
        <SolidColorBrush x:Key="ThemeWindowBg"    Color="#141109"/>
        <SolidColorBrush x:Key="ThemePanelBg"     Color="#1c1810"/>
        <SolidColorBrush x:Key="ThemeEditorBg"    Color="#1a1712"/>
        <SolidColorBrush x:Key="ThemeText"        Color="#E8E2D4"/>
        <SolidColorBrush x:Key="ThemeTextMuted"   Color="#A89F8C"/>
        <SolidColorBrush x:Key="ThemeAccentRed"   Color="#E5382B"/>
        <SolidColorBrush x:Key="ThemeAccentGold"  Color="#E6C463"/>
        <SolidColorBrush x:Key="ThemeButtonBg"    Color="#262016"/>
        <SolidColorBrush x:Key="ThemeButtonBorder" Color="#3A3226"/>
        <SolidColorBrush x:Key="ThemeGutterBg"    Color="#211D16"/>
        <SolidColorBrush x:Key="ThemeHoverBg"     Color="#33E5382B"/>
        <!-- Brushes de SISTEMA del menú (WPF/Aero los usa hardcodeados): barra + desplegables oscuros -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E8E2D4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1C1810"/>
        <!-- Chrome text claro sobre oscuro (el editor usa Runs con color propio, no le afecta) -->
        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
        </Style>
        <!-- Tooltips oscuros para que sigan legibles -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/>
        </Style>
        <!-- Etiquetas de sección (Numbers:, Angles:, ...) y demás TextBlocks de chrome.
             El editor usa Runs con Foreground explícito, así que no le afecta. -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
        </Style>
        <!-- ComboBox: chrome claro por defecto → forzamos texto OSCURO (el TextBlock global
             claro lo volvería invisible). Legibles dentro de la UI oscura. -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#141109"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#141109"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Toggle" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="FontFamily" Value="Roboto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid x:Name="grid">
                            <Border x:Name="ButtonBorder" CornerRadius="3"
                                    BorderBrush="{DynamicResource ThemeButtonBorder}"
                                    BorderThickness="1" Padding="4,1,4,1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentGold}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeButtonBg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentRed}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Roboto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="6"
                                    Background="{DynamicResource ThemeButtonBg}"
                                    BorderBrush="{DynamicResource ThemeButtonBorder}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentRed}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormatButton" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontFamily" Value="Roboto"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="ButtonBorder" CornerRadius="3"
                                    Background="{DynamicResource ThemeButtonBg}"
                                    BorderBrush="{DynamicResource ThemeButtonBorder}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentRed}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GreekLetter" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="14"/>
            <!-- Was "Times New Romans" (typo) — WPF couldn't resolve it and
                 fell back to a font without Unicode Greek glyphs, so the
                 letters in GreekLettersWarpPanel showed as boxes / blank. -->
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" Value="Bisque"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MarkdownCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#666"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C0E5382B"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#26E5382B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <RoutedUICommand x:Key="WebFormCommand" Text="Web Form" />
        <RoutedUICommand x:Key="CalculateCommand" Text="{x:Static wpf:MainWindowResources.Calculate}" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F4" Command="{StaticResource WebFormCommand}" />
        <KeyBinding Key="F5" Command="{StaticResource CalculateCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Executed="Command_WebForm" Command="{StaticResource WebFormCommand}"/>
        <CommandBinding Executed="Command_Calculate" Command="{StaticResource CalculateCommand}"/>
        <CommandBinding Executed="Command_New" Command="New"/>
        <CommandBinding Executed="Command_Open" Command="Open"/>
        <CommandBinding Executed="Command_Save" Command="Save"/>
        <CommandBinding Executed="Command_SaveAs" Command="SaveAs"/>
        <CommandBinding Executed="Command_Close" Command="Close"/>
        <CommandBinding Executed="Command_Help" Command="Help"/>
        <CommandBinding Executed="Command_Print" Command="Print"/>
        <CommandBinding Executed="Command_Find" Command="Find"/>
        <CommandBinding Executed="Command_Replace" Command="Replace"/>
        <CommandBinding Executed="Command_FindNext" Command="Search"/>
        <CommandBinding Executed="Command_Copy" Command="Copy"/>
        <CommandBinding Executed="Command_Paste" Command="Paste"/>
        <CommandBinding Executed="Command_Undo" Command="Undo"/>
        <CommandBinding Executed="Command_Redo" Command="Redo"/>
    </Window.CommandBindings>
    <Grid x:Name="MainGrid" MinWidth="1190" Background="{DynamicResource ThemeWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu x:Name="MainMenu" VerticalAlignment="Top" Margin="2,2,2,0" Background="{x:Null}" Height="18"
              Foreground="{DynamicResource ThemeText}">
            <MenuItem Foreground="{DynamicResource ThemeText}">
                <MenuItem.Header>
                    <TextBlock Text="{x:Static wpf:MainWindowResources.File}" Foreground="{DynamicResource ThemeText}"/>
                </MenuItem.Header>
                <MenuItem Command="ApplicationCommands.New" 
                          Header="{x:Static wpf:MainWindowResources.New}"/>
                <MenuItem Command="ApplicationCommands.Open" 
                          Header="{x:Static wpf:MainWindowResources.Open}"/>
                <MenuItem x:Name="MenuRecent" 
                          Header="{x:Static wpf:MainWindowResources.RecentFiles}"/>
                <MenuItem x:Name="MenuSave" 
                          Command="ApplicationCommands.Save" 
                          Header="{x:Static wpf:MainWindowResources.Save}"/>
                <MenuItem Command="ApplicationCommands.SaveAs" 
                          Header="{x:Static wpf:MainWindowResources.SaveAs}"/>
                <MenuItem Click="MenuCli_Click"
                          Header="{x:Static wpf:MainWindowResources.CommandLineInterpreter}"/>
                <Separator/>
                <MenuItem x:Name="MenuExcelViewer" Header="Open Excel Viewer (.xlsx)"
                          Click="MenuExcelViewer_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuExportPlugin" Header="Export to MathCad Prime (.mcdx)"
                          Click="MenuExportPlugin_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="MenuImportPlugin" Header="Import from MathCad Prime (.mcdx)"
                          Click="MenuImportPlugin_Click" Visibility="Collapsed"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Close"
                          Header="{x:Static wpf:MainWindowResources.Exit}"/>
            </MenuItem>
            <MenuItem x:Name="MenuEdit" Foreground="{DynamicResource ThemeText}">
                <MenuItem.Header>
                    <TextBlock Text="{x:Static wpf:MainWindowResources.Edit}" Foreground="{DynamicResource ThemeText}"/>
                </MenuItem.Header>
                <MenuItem Command="ApplicationCommands.Find" 
                          Header="{x:Static wpf:MainWindowResources.Find}"/>
                <MenuItem Command="ApplicationCommands.Replace"
                          Header="{x:Static wpf:MainWindowResources.Replace}"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Undo" 
                          Header="{x:Static wpf:MainWindowResources.Undo}"/>
                <MenuItem Command="ApplicationCommands.Redo" 
                          Header="{x:Static wpf:MainWindowResources.Redo}"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Cut" 
                          Header="{x:Static wpf:MainWindowResources.Cut}"/>
                <MenuItem Command="ApplicationCommands.Copy" 
                          Header="{x:Static wpf:MainWindowResources.Copy}"/>
                <MenuItem Command="ApplicationCommands.Paste" 
                          Header="{x:Static wpf:MainWindowResources.Paste}"/>
                <Separator/>
                <MenuItem x:Name="PasteAsCommentMenu" InputGestureText="Ctrl+Shift+V" Click="PasteAsCommentMenu_Click"
                          Header="{x:Static wpf:MainWindowResources.PasteAsComment}"/>
                <MenuItem x:Name="CommentMenu"  InputGestureText="Ctrl+Q"
                          Header="{x:Static wpf:MainWindowResources.CommentSelectedLines}" Click="CommentMenu_Click"/>
                <MenuItem x:Name="UncommentMenu"  InputGestureText="Ctrl+Shift+Q"
                          Header="{x:Static wpf:MainWindowResources.UncommentSelectedLines}" Click="UncommentMenu_Click"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.SelectAll" 
                          Header="{x:Static wpf:MainWindowResources.Select_All}"/>
            </MenuItem>
            <MenuItem x:Name="MenuInsert" Foreground="{DynamicResource ThemeText}">
                <MenuItem.Header>
                    <TextBlock Text="{x:Static wpf:MainWindowResources.Insert}" Foreground="{DynamicResource ThemeText}"/>
                </MenuItem.Header>
                <!-- ================= Hekatan Lab: menu Insert con sintaxis MATLAB (no Calcpad) ================= -->
                <MenuItem Click="LoopBuilderMenu_Click" Header="∑ ∏ ∫  Constructor de loop…"
                          ToolTip="Sumatoria / productoria / integral en notación matemática → MATLAB (o escribe .loop)"/>
                <Separator/>
                <MenuItem Header="Comment / sections">
                    <!-- VISIBLES en el output (llevan marcador) -->
                    <MenuItem Click="Button_Click" Tag="% '" Header="% '  texto VISIBLE"          ToolTip="Texto visible en el output (apostrofo ' = texto)"/>
                    <MenuItem Click="Button_Click" Tag="%% " Header="%%  seccion (OCULTO, como MATLAB)" ToolTip="Comentario de seccion: NO sale en el output (como MATLAB). Para titulo visible usa %'"/>
                    <MenuItem Click="Button_Click" Tag="% #noc " Header="% #noc  formula"         ToolTip="Formula tipografiada (Calcpad), visible"/>
                    <MenuItem Click="Button_Click" Tag="% #md§§% #endmd" Header="% #md ... #endmd  (Markdown)" ToolTip="Bloque Markdown: titulos #, tablas, listas, **negrita**, -&gt; centrado &lt;-"/>
                    <MenuItem Click="Button_Click" Tag="% #plain§§% #render" Header="% #plain ... #render" ToolTip="Texto plano vs renderizado en disp/fprintf"/>
                    <Separator/>
                    <!-- OCULTOS (Hekatan Lab NO los muestra) -->
                    <MenuItem Click="Button_Click" Tag="% " Header="%  comentario OCULTO"         ToolTip="Comentario de codigo: Hekatan Lab NO lo muestra (como MATLAB)"/>
                    <MenuItem Click="Button_Click" Tag="%-- " Header="%--  oculto (explicito)"    ToolTip="Comentario que Hekatan Lab NO muestra en la salida"/>
                    <MenuItem Click="Button_Click" Tag="%{§§%}" Header="%{ ... %}  bloque oculto" ToolTip="Comentario de bloque MATLAB (oculto)"/>
                    <Separator/>
                    <MenuItem Click="Button_Click" Tag="..." Header="...  continuacion"           ToolTip="Continuar la sentencia en la linea siguiente"/>
                </MenuItem>
                <MenuItem Header="{x:Static wpf:ConstantsResources.Constants_Header}">
                    <MenuItem Click="Button_Click" Tag="pi"       Header="pi"       ToolTip="3.14159..."/>
                    <MenuItem Click="Button_Click" Tag="exp(1)"   Header="e = exp(1)" ToolTip="Numero de Euler"/>
                    <MenuItem Click="Button_Click" Tag="eps"      Header="eps"      ToolTip="Epsilon de maquina"/>
                    <MenuItem Click="Button_Click" Tag="Inf"      Header="Inf"      ToolTip="Infinito"/>
                    <MenuItem Click="Button_Click" Tag="NaN"      Header="NaN"      ToolTip="No es un numero"/>
                    <MenuItem Click="Button_Click" Tag="i"        Header="i  (imag)" ToolTip="Unidad imaginaria"/>
                    <Separator/>
                    <MenuItem Click="Button_Click" Tag="true"     Header="true"     ToolTip="Verdadero logico (1)"/>
                    <MenuItem Click="Button_Click" Tag="false"    Header="false"    ToolTip="Falso logico (0)"/>
                </MenuItem>
                <MenuItem Header="{x:Static wpf:MathResources.Operators}">
                    <MenuItem Header="Arithmetic">
                        <MenuItem Click="Button_Click" Tag="+" Header="+   addition"/>
                        <MenuItem Click="Button_Click" Tag="-" Header="-   subtraction"/>
                        <MenuItem Click="Button_Click" Tag="*" Header="*   matrix multiply"/>
                        <MenuItem Click="Button_Click" Tag="/" Header="/   right divide"/>
                        <MenuItem Click="Button_Click" Tag="\" Header="\   left divide / solve"/>
                        <MenuItem Click="Button_Click" Tag="^" Header="^   matrix power"/>
                    </MenuItem>
                    <MenuItem Header="Element-wise (.op)">
                        <MenuItem Click="Button_Click" Tag=".*" Header=".*   times"/>
                        <MenuItem Click="Button_Click" Tag="./" Header="./   right divide"/>
                        <MenuItem Click="Button_Click" Tag=".\" Header=".\   left divide"/>
                        <MenuItem Click="Button_Click" Tag=".^" Header=".^   power"/>
                        <MenuItem Click="Button_Click" Tag="'"  Header="'    conjugate transpose"/>
                        <MenuItem Click="Button_Click" Tag=".'" Header=".'   transpose"/>
                    </MenuItem>
                    <MenuItem Header="Relational">
                        <MenuItem Click="Button_Click" Tag="==" Header="==   equal"/>
                        <MenuItem Click="Button_Click" Tag="~=" Header="~=   not equal"/>
                        <MenuItem Click="Button_Click" Tag="&lt;"  Header="&lt;    less than"/>
                        <MenuItem Click="Button_Click" Tag="&gt;"  Header="&gt;    greater than"/>
                        <MenuItem Click="Button_Click" Tag="&lt;=" Header="&lt;=   less or equal"/>
                        <MenuItem Click="Button_Click" Tag="&gt;=" Header="&gt;=   greater or equal"/>
                    </MenuItem>
                    <MenuItem Header="Logical">
                        <MenuItem Click="Button_Click" Tag="&amp;"  Header="&amp;    and (element-wise)"/>
                        <MenuItem Click="Button_Click" Tag="|"  Header="|    or (element-wise)"/>
                        <MenuItem Click="Button_Click" Tag="~"  Header="~    not"/>
                        <MenuItem Click="Button_Click" Tag="&amp;&amp;" Header="&amp;&amp;   and (short-circuit)"/>
                        <MenuItem Click="Button_Click" Tag="||" Header="||   or (short-circuit)"/>
                    </MenuItem>
                    <MenuItem Header="Range / assign">
                        <MenuItem Click="Button_Click" Tag="1:n"     Header="1:n       range"/>
                        <MenuItem Click="Button_Click" Tag="a:step:b" Header="a:step:b  range with step"/>
                        <MenuItem Click="Button_Click" Tag="="       Header="=         assignment"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{x:Static wpf:MathResources.Functions}">
                    <MenuItem Header="{x:Static wpf:MathResources.Trigonometric}">
                        <MenuItem Click="Button_Click" Tag="sin(x)" Header="sin(x)"/>
                        <MenuItem Click="Button_Click" Tag="cos(x)" Header="cos(x)"/>
                        <MenuItem Click="Button_Click" Tag="tan(x)" Header="tan(x)"/>
                        <MenuItem Click="Button_Click" Tag="cot(x)" Header="cot(x)"/>
                        <MenuItem Click="Button_Click" Tag="sec(x)" Header="sec(x)"/>
                        <MenuItem Click="Button_Click" Tag="csc(x)" Header="csc(x)"/>
                        <Separator/>
                        <MenuItem Click="Button_Click" Tag="asin(x)" Header="asin(x)"/>
                        <MenuItem Click="Button_Click" Tag="acos(x)" Header="acos(x)"/>
                        <MenuItem Click="Button_Click" Tag="atan(x)" Header="atan(x)"/>
                        <MenuItem Click="Button_Click" Tag="atan2(y, x)" Header="atan2(y, x)"/>
                        <Separator/>
                        <MenuItem Click="Button_Click" Tag="deg2rad(x)" Header="deg2rad(x)"/>
                        <MenuItem Click="Button_Click" Tag="rad2deg(x)" Header="rad2deg(x)"/>
                    </MenuItem>
                    <MenuItem Header="{x:Static wpf:MathResources.Hyperbolic}">
                        <MenuItem Click="Button_Click" Tag="sinh(x)" Header="sinh(x)"/>
                        <MenuItem Click="Button_Click" Tag="cosh(x)" Header="cosh(x)"/>
                        <MenuItem Click="Button_Click" Tag="tanh(x)" Header="tanh(x)"/>
                        <MenuItem Click="Button_Click" Tag="asinh(x)" Header="asinh(x)"/>
                        <MenuItem Click="Button_Click" Tag="acosh(x)" Header="acosh(x)"/>
                        <MenuItem Click="Button_Click" Tag="atanh(x)" Header="atanh(x)"/>
                    </MenuItem>
                    <MenuItem Header="{x:Static wpf:MathResources.LogarithmicExponentialAndRoots}">
                        <MenuItem Click="Button_Click" Tag="exp(x)"    Header="exp(x)"/>
                        <MenuItem Click="Button_Click" Tag="log(x)"    Header="log(x)   natural log"/>
                        <MenuItem Click="Button_Click" Tag="log2(x)"   Header="log2(x)"/>
                        <MenuItem Click="Button_Click" Tag="log10(x)"  Header="log10(x)"/>
                        <Separator/>
                        <MenuItem Click="Button_Click" Tag="sqrt(x)"   Header="sqrt(x)"/>
                        <MenuItem Click="Button_Click" Tag="nthroot(x, n)" Header="nthroot(x, n)"/>
                        <MenuItem Click="Button_Click" Tag="hypot(a, b)" Header="hypot(a, b)"/>
                    </MenuItem>
                    <MenuItem Header="{x:Static wpf:MathResources.Rounding}">
                        <MenuItem Click="Button_Click" Tag="round(x)" Header="round(x)"/>
                        <MenuItem Click="Button_Click" Tag="floor(x)" Header="floor(x)"/>
                        <MenuItem Click="Button_Click" Tag="ceil(x)"  Header="ceil(x)"/>
                        <MenuItem Click="Button_Click" Tag="fix(x)"   Header="fix(x)   toward zero"/>
                        <MenuItem Click="Button_Click" Tag="sign(x)"  Header="sign(x)"/>
                        <MenuItem Click="Button_Click" Tag="abs(x)"   Header="abs(x)"/>
                    </MenuItem>
                    <MenuItem Header="{x:Static wpf:MathResources.Integer}">
                        <MenuItem Click="Button_Click" Tag="mod(a, b)" Header="mod(a, b)"/>
                        <MenuItem Click="Button_Click" Tag="rem(a, b)" Header="rem(a, b)"/>
                        <MenuItem Click="Button_Click" Tag="gcd(a, b)" Header="gcd(a, b)"/>
                        <MenuItem Click="Button_Click" Tag="lcm(a, b)" Header="lcm(a, b)"/>
                        <MenuItem Click="Button_Click" Tag="factorial(n)" Header="factorial(n)"/>
                    </MenuItem>
                    <MenuItem Header="{x:Static wpf:MathResources.Complex}">
                        <MenuItem Click="Button_Click" Tag="real(z)"  Header="real(z)"/>
                        <MenuItem Click="Button_Click" Tag="imag(z)"  Header="imag(z)"/>
                        <MenuItem Click="Button_Click" Tag="abs(z)"   Header="abs(z)"/>
                        <MenuItem Click="Button_Click" Tag="angle(z)" Header="angle(z)"/>
                        <MenuItem Click="Button_Click" Tag="conj(z)"  Header="conj(z)"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Arrays &amp; matrices">
                    <MenuItem Header="{x:Static wpf:MainWindowResources.Creational}">
                        <MenuItem Click="Button_Click" Tag="zeros(m, n)"     Header="zeros(m, n)"/>
                        <MenuItem Click="Button_Click" Tag="ones(m, n)"      Header="ones(m, n)"/>
                        <MenuItem Click="Button_Click" Tag="eye(n)"          Header="eye(n)   identity"/>
                        <MenuItem Click="Button_Click" Tag="rand(m, n)"      Header="rand(m, n)"/>
                        <MenuItem Click="Button_Click" Tag="randn(m, n)"     Header="randn(m, n)"/>
                        <MenuItem Click="Button_Click" Tag="linspace(a, b, n)" Header="linspace(a, b, n)"/>
                        <MenuItem Click="Button_Click" Tag="[1, 2, 3]"       Header="[1, 2, 3]   row vector"/>
                        <MenuItem Click="Button_Click" Tag="[1; 2; 3]"       Header="[1; 2; 3]   column vector"/>
                        <MenuItem Click="Button_Click" Tag="repmat(A, m, n)" Header="repmat(A, m, n)"/>
